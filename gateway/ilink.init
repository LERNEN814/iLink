#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    local lan_ip
    lan_ip=$(uci -q get network.lan.ipaddr)
    [ -n "$lan_ip" ] || return 1
    mkdir -p /var/run/ilink
    chown root:ilink /var/run/ilink
    chmod 0750 /var/run/ilink
    procd_open_instance ilink
    procd_set_param user ilink
    procd_set_param group ilink
    procd_set_param no_new_privs 1
    procd_set_param limits core="0"
    procd_set_param command /usr/sbin/uhttpd -f -D -S \
        -h /usr/lib/ilink/www -x /v1 \
        -p 127.0.0.1:8089 -s "$lan_ip:8443" \
        -C /etc/ilink/uhttpd.crt -K /etc/ilink/uhttpd.key \
        -n 4 -N 16 -t 5 -T 10
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}
