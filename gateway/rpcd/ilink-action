#!/usr/bin/lua
-- Privileged helper for the actions the ilink gateway cannot perform itself.
-- rpcd runs this as root; ubusd's ACL decides which callers may invoke it, and
-- every method takes a fixed argument set.
local json = require "luci.jsonc"
local fs = require "nixio.fs"
local sys = require "luci.sys"
local nixio = require "nixio"

local CONFIG_DIR = "/etc/openclash/config"
local SERVICE = "/etc/init.d/openclash"
local UPGRADE_SCRIPT = "/usr/libexec/ilink-upgrade.sh"
local EXEC_SCRIPT = "/tmp/ilink-exec.sh"

local function quote(value)
    return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function capture(command)
    local handle = io.popen(command)
    if not handle then return "" end
    local output = handle:read("*a") or ""
    handle:close()
    return output
end

local function valid_config(name)
    if type(name) ~= "string" or #name > 128 then return false end
    if not name:match("^[%w_%-%.]+%.ya?ml$") or name:find("%.%.") then
        return false
    end
    local stat = fs.stat(CONFIG_DIR .. "/" .. name)
    return stat ~= nil and stat.type == "reg"
end

local function reply(value)
    print(json.stringify(value))
end

local function subscription_url(name)
    if type(name) ~= "string" or not name:match("^[%w_%-]+$") then return nil end
    local raw = fs.readfile("/etc/config/openclash") or ""
    local current, pending
    for line in raw:gmatch("[^%c]+") do
        if line:match("^config%s+config_subscribe") then
            pending = { name = nil, address = nil }
        elseif pending then
            local value = line:match("^%s*option%s+name%s+'([^']*)'")
            if value then pending.name = value end
            local address = line:match("^%s*option%s+address%s+'([^']*)'")
            if address then pending.address = address end
            if line:match("^config%s") and not line:match("config_subscribe") then
                if pending.name == name then return pending.address end
                pending = nil
            end
            if pending and pending.name == name and pending.address then
                return pending.address
            end
        end
    end
    if pending and pending.name == name then return pending.address end
    return nil
end

local function subscription_info(name)
    local url = subscription_url(name)
    if not url or not url:match("^https?://") then
        return reply({ error = "subscription not found" })
    end
    local header = "/tmp/ilink-sub-" .. tostring(os.time() % 100000) .. ".hdr"
    sys.exec("/usr/bin/curl -sS -m 25 -A 'clash-verge/v2.4.5' -D " ..
        quote(header) .. " -o /dev/null " .. quote(url))
    local raw = fs.readfile(header) or ""
    fs.unlink(header)
    local info = raw:match("[Ss]ubscription%-[Uu]serinfo:%s*([^%c]+)")
    if not info then return reply({ error = "no subscription info" }) end
    local result = {}
    for key, value in info:gmatch("(%a+)%s*=%s*([%d]+)") do
        result[key:lower()] = tonumber(value)
    end
    return reply(result)
end

-- Packages iStoreOS pins with `Status: ... hold` never upgrade via opkg, so a
-- one-click upgrade would report them as pending forever.
local function held_packages()
    local held, current = {}, "?"
    for line in (fs.readfile("/usr/lib/opkg/status") or ""):gmatch("[^%c]+") do
        local name = line:match("^Package:%s*(%S+)")
        if name then
            current = name
        elseif line:match("^Status:") and line:find("hold", 1, true) then
            held[current] = true
        end
    end
    return held
end

local function upgradable()
    local held = held_packages()
    local names = {}
    for line in (capture("/bin/opkg list-upgradable 2>/dev/null")):gmatch("[^%c]+") do
        local name = line:match("^(%S+)%s+%-")
        if name and name:match("^[%w%.%+_%-]+$") and name ~= "Multiple"
            and not held[name] then
            names[#names + 1] = name
        end
        if #names > 200 then break end
    end
    table.sort(names)
    return names
end

local function traffic()
    local device = capture(
        "ip route show default 2>/dev/null | sed -n 's/.*dev \\([^ ]*\\).*/\\1/p' | head -1"
    ):gsub("%s+", "")
    if device == "" then device = "eth0" end
    local rx, tx = 0, 0
    for line in (fs.readfile("/proc/net/dev") or ""):gmatch("[^%c]+") do
        local name, values = line:match("^%s*([%w%.%-]+):%s*(.+)$")
        if name == device then
            local fields = {}
            for value in values:gmatch("%d+") do fields[#fields + 1] = tonumber(value) end
            rx = fields[1] or 0
            tx = fields[9] or 0
        end
    end
    local seconds, micros = nixio.gettimeofday()
    return reply({
        device = device,
        rx = rx,
        tx = tx,
        ts = seconds + micros / 1000000
    })
end

-- Ported from FlClash's ip_quality lookup: the exit address is read through the
-- proxy, then public databases are asked about that address. Wave/hedge racing
-- is dropped because one request per source is enough at human pacing.
local function json_curl(url, extra)
    local out = capture("/usr/bin/curl -sS -m 8 " .. (extra or "") .. " " .. quote(url))
    if out == "" then return nil end
    local ok, parsed = pcall(json.parse, out)
    if not ok or type(parsed) ~= "table" then return nil end
    return parsed
end

local function proxy_credentials()
    local user = capture("uci -q get openclash.@authentication[0].username"):gsub("%s+$", "")
    local password = capture("uci -q get openclash.@authentication[0].password"):gsub("%s+$", "")
    if user == "" then return "" end
    return " --proxy-user " .. quote(user .. ":" .. password)
end

local function declared_type(value)
    if value == "isp" or value == "residential" then return "residential" end
    if value == "business" or value == "education" or value == "government" then
        return "business"
    end
    if value == "hosting" or value == "datacenter" then return "hosting" end
    if value == "mobile" or value == "wireless" then return "mobile" end
    return nil
end

local function ip_check()
    local port = capture("uci -q get openclash.config.http_port"):gsub("%s+$", "")
    if port == "" then port = "7890" end
    local proxy = " --proxy " .. quote("http://127.0.0.1:" .. port) ..
        proxy_credentials()
    local exit_info = json_curl("https://ident.me/json", proxy)
    if not exit_info or type(exit_info.ip) ~= "string" then
        return reply({ error = "proxy unreachable" })
    end
    local ip = exit_info.ip
    local details = json_curl("https://api.ipapi.is/?q=" .. ip)
    local risk = json_curl("https://api.ipquery.io/" .. ip .. "?format=json")
    local is_datacenter, is_mobile, is_proxy, is_vpn, is_tor, is_abuser =
        false, false, false, false, false, false
    if details then
        is_datacenter = details.is_datacenter == true
        is_mobile = details.is_mobile == true
        is_proxy = details.is_proxy == true
        is_vpn = details.is_vpn == true
        is_tor = details.is_tor == true
        is_abuser = details.is_abuser == true
    end
    if risk and type(risk.risk) == "table" then
        is_datacenter = is_datacenter or risk.risk.is_datacenter == true
        is_mobile = is_mobile or risk.risk.is_mobile == true
        is_proxy = is_proxy or risk.risk.is_proxy == true
        is_vpn = is_vpn or risk.risk.is_vpn == true
        is_tor = is_tor or risk.risk.is_tor == true
    end
    local kind = declared_type(exit_info.type)
    if is_datacenter then
        kind = "hosting"
    elseif kind == nil and is_mobile then
        kind = "mobile"
    end
    if kind == nil then kind = "residential" end
    local company = type(details) == "table" and details.company or nil
    local organization = (type(company) == "table" and company.name)
        or exit_info.aso or (type(details) == "table" and details.asn and details.asn.org)
        or nil
    return reply({
        ip = ip,
        type = kind,
        organization = organization,
        asn = exit_info.asn or (type(details) == "table" and details.asn and details.asn.asn) or nil,
        country = exit_info.country,
        countryCode = exit_info.cc,
        city = exit_info.city,
        isProxy = is_proxy,
        isVpn = is_vpn,
        isTor = is_tor,
        isAbuser = is_abuser,
        source = details and "ipapi.is" or (risk and "ipquery.io" or "ident.me")
    })
end

local function run_command(command)
    if type(command) ~= "string" or command == "" or #command > 4000 then
        return reply({ error = "invalid command" })
    end
    local line = string.char(10)
    fs.writefile(EXEC_SCRIPT, "#!/bin/sh" .. line .. command .. line)
    local handle = io.popen("timeout 30 /bin/sh " .. EXEC_SCRIPT .. " 2>&1; echo __ILINK_EXIT:$?")
    local output = handle and handle:read("*a") or ""
    if handle then handle:close() end
    local code = tonumber(output:match("__ILINK_EXIT:(%d+)")) or 1
    output = output:gsub("%c*__ILINK_EXIT:%d+%c*$", "")
    return reply({ output = output, code = code })
end

local function start_upgrade()
    local running = {}
    for _, item in ipairs({
        { name = "openclash", process = "clash" },
        { name = "alist", process = "alist" },
        { name = "aria2", process = "aria2c" },
        { name = "qbittorrent", process = "qbittorrent-nox" },
        { name = "fastnet", process = "FastNet" },
        { name = "ddnsto", process = "ddnsto" }
    }) do
        if sys.call("pidof " .. item.process .. " >/dev/null 2>&1") == 0 then
            running[#running + 1] = item.name
        end
    end
    fs.writefile("/tmp/ilink-upgrade.services", table.concat(running, " "))
    fs.writefile("/tmp/ilink-upgrade.log", "")
    sys.call("setsid " .. UPGRADE_SCRIPT .. " >/tmp/ilink-upgrade.log 2>&1 &")
    return reply({ started = true, services = running })
end

local function upgrade_status()
    local log = fs.readfile("/tmp/ilink-upgrade.log") or ""
    local state = "running"
    if log:find("DONE", 1, true) then
        state = "done"
    elseif log:find("ERROR", 1, true) then
        state = "error"
    elseif log == "" then
        state = "idle"
    end
    local tail = {}
    for line in log:gmatch("[^%c]+") do
        tail[#tail + 1] = line
        if #tail > 8 then table.remove(tail, 1) end
    end
    return reply({ state = state, tail = tail })
end

local function call(method)
    local input = io.stdin and io.stdin:read("*a") or ""
    local body = {}
    if input and input ~= "" then body = json.parse(input) or {} end

    if method == "openclash" then
        local op = body.op
        if op ~= "start" and op ~= "stop" and op ~= "restart" then
            return reply({ error = "invalid operation" })
        end
        sys.exec(SERVICE .. " " .. op)
        return reply({ done = op })
    end

    if method == "traffic" then return traffic() end
    if method == "ipcheck" then return ip_check() end
    if method == "exec" then return run_command(body.command) end
    if method == "upgrade" then return start_upgrade() end
    if method == "upgrade-status" then return upgrade_status() end

    if method == "updates" then
        local names = upgradable()
        local held = held_packages()
        local pinned = 0
        for line in (capture("/bin/opkg list-upgradable 2>/dev/null")):gmatch("[^%c]+") do
            local name = line:match("^(%S+)%s+%-")
            if name and held[name] then pinned = pinned + 1 end
        end
        return reply({ count = #names, packages = names, pinned = pinned })
    end

    if method == "subscription-info" then
        return subscription_info(body.name)
    end

    if method == "switch-config" then
        if not valid_config(body.name) then
            return reply({ error = "invalid config" })
        end
        local path = CONFIG_DIR .. "/" .. body.name
        sys.exec("uci set openclash.config.config_path=" .. quote(path))
        sys.exec("uci commit openclash")
        sys.exec(SERVICE .. " restart")
        return reply({ config = body.name })
    end

    reply({ error = "unknown method" })
end

if arg[1] == "list" then
    reply({
        openclash = { op = "start|stop|restart" },
        ["switch-config"] = { name = "" },
        ["subscription-info"] = { name = "" },
        updates = { refresh = false },
        traffic = { sample = false },
        ipcheck = { sample = false },
        exec = { command = "" },
        upgrade = { confirm = false },
        ["upgrade-status"] = { tail = 0 }
    })
elseif arg[1] == "call" then
    call(arg[2])
else
    reply({ error = "usage: list|call <method>" })
end
